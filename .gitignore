# ---------------------------------------------------------------------
# Almost nothing in this repository is generated: the SQL is the source,
# the HTML pages are hand-written, and the QA suites build their own
# throwaway databases and drop them again. So this file is short on
# purpose -- each entry below is here for a stated reason rather than
# copied from a template.
# ---------------------------------------------------------------------

# Installed dependencies. package.json and package-lock.json are the
# source of truth; the tree itself is 87 packages that npm can rebuild.
node_modules/

# Credentials. The suites take the password from $env:PGPASSWORD and the
# API from PGPASSWORD / SESSION_SECRET, never from a file, so nothing
# here should ever exist -- these patterns are a backstop against one
# being added by hand later.
.env
.env.*
*.pgpass
secrets.*

# npm / node noise
npm-debug.log*
.npm/

# psql / pg_dump scratch output, if anyone redirects into the tree
*.dump
*.backup
psql_history
.psql_history

# Editors and OS
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
.DS_Store

# Next.js build output and the files it generates on every run
.next/
out/
next-env.d.ts
*.tsbuildinfo
.vercel/
.env*
