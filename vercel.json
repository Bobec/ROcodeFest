{
  "builds": [
    { "src": "api/server.js", "use": "@vercel/node" },
    { "src": "*.html", "use": "@vercel/static" },
    { "src": "impuls.css", "use": "@vercel/static" },
    { "src": "rocodefest-rules.pdf", "use": "@vercel/static" },
    { "src": "assets/**", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/(api|auth)(/.*)?", "dest": "/api/server.js" },
    { "src": "/", "dest": "/index.html" },
    { "handle": "filesystem" },
    { "src": "/([a-z0-9-]+)", "dest": "/$1.html" }
  ]
}
